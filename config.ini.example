# VibeDoMuse 配置模板
# 使用方法：复制本文件为 config.ini 并填写你的 LLM 配置。
#   命令行：  cp config.ini.example config.ini
#   Windows： copy config.ini.example config.ini
# 注意：config.ini 含个人 API Key，已被 .gitignore 忽略，切勿提交到仓库。

[llm]
base_url = http://127.0.0.1:1234/v1
model = model
api_key = 
timeout = 15
temperature = 0.3

[app]
theme = light
language = en

[server]
port = 8000
bind = 127.0.0.1
token = 
